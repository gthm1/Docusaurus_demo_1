{
  "name": "gd-multitenant-demo",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "build:internal": "node scripts/prepare-and-build.mjs internal",
    "build:acme": "node scripts/prepare-and-build.mjs customer acme",
    "build:beta": "node scripts/prepare-and-build.mjs customer beta",
    "build:all": "npm run build:internal && npm run build:acme && npm run build:beta",
    "build:editor": "tinacms build",
    "tina:dev": "cross-env TINA_LOCAL_DEV=1 tinacms dev -c \"docusaurus start\"",
    "tina:build": "tinacms build"
  },
  "dependencies": {
    "@docusaurus/core": "3.9.2",
    "@docusaurus/preset-classic": "3.9.2",
    "@mdx-js/react": "^3.0.0",
    "@tinacms/cli": "^2.5.6",
    "clsx": "^2.0.0",
    "gray-matter": "^4.0.3",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tinacms": "^3.11.0"
  },
  "devDependencies": {
    "@cmfcmf/docusaurus-search-local": "^2.0.1",
    "@docusaurus/module-type-aliases": "3.9.2",
    "@docusaurus/types": "3.9.2",
    "cross-env": "^10.1.0"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=20.0"
  },
  "overrides": {
    "webpack": "5.97.1"
  }
}
